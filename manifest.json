{
  "manifest_version": 3,
  "name": "Regroupeur pour Cardmarket",
  "short_name": "Regroupeur",
  "version": "1.0.0",
  "description": "Trouve les vendeurs Cardmarket qui ont le plus de cartes de ta liste : moins de commandes, moins de port. Non officiel.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Regroupeur pour Cardmarket",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://www.cardmarket.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.cardmarket.com/*"],
      "js": [
        "src/cm.js",
        "src/optimizer.js",
        "src/fetcher.js",
        "src/storage.js",
        "src/analyzer.js",
        "src/cart.js",
        "src/panel.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/panel.css"],
      "matches": ["https://www.cardmarket.com/*"]
    }
  ]
}
